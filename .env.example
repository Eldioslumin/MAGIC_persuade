# API Key for the LLM provider (OpenAI, OpenRouter, etc.)
# If using local Ollama, you can set this to "ollama" or anything.
LLM_API_KEY=your_api_key_here

# Base URL (Optional)
# - OpenRouter: https://openrouter.ai/api/v1
# - Local Ollama: http://localhost:11434/v1
# - OpenAI: Leave commented out
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Model Name
# - OpenAI: gpt-4o, gpt-3.5-turbo
# - OpenRouter: openai/gpt-4o, meta-llama/llama-3-70b-instruct
# - Ollama: llama3, mistral
LLM_MODEL=gpt-3.5-turbo

# --- Parallel Provider Configuration ---

# OpenRouter Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_API_KEY=your_openrouter_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
OLLAMA_API_KEY=ollama
